#!/usr/bin/env bash
# ============================================================================
# vortexctl —— Vortex 组合镜像的统一启动器（common 提供，各服务被它编排）。
#
#   vortexctl <svc>     前台启动单个服务（data|qmt|backtest|trader）。
#                       这是镜像的唯一运行形态：一进程一容器（与 k8s 对齐）。
#                       compose/k8s 里每个容器/Pod 的 command 即 `vortexctl <svc>`。
#   vortexctl list      打印各服务的启动解析（来自 deploy/run.sh 还是内置默认）。
#
# 启动契约：优先执行该仓「通用位置」的 /app/services/vortex_<svc>/deploy/run.sh
#           （各仓自描述如何启动自己）；不存在则回退到内置默认命令（builtin_start）。
#           各服务从统一 env 读取 host/port/目录。
#
# 不提供「单容器跑全部」模式：多服务请用 compose/k8s 各起一容器（见 deploy/README）。
# ============================================================================
set -euo pipefail

# 端口/网络/TZ 默认来自配置真值源生成的 env（烤入镜像 /app/config/）。VORTEX_GENERATED_ENV 可覆盖（测试用）。
GENERATED_ENV="${VORTEX_GENERATED_ENV:-/app/config/vortex.generated.env}"
[ -f "$GENERATED_ENV" ] && { set -a; . "$GENERATED_ENV"; set +a; }

# ---- 统一环境默认值（compose / docker run 可逐项覆盖）----
export VORTEX_WORKSPACE="${VORTEX_WORKSPACE:-/workspace}"
export VORTEX_STATE="${VORTEX_STATE:-/state}"

export VORTEX_DATA_HOST="${VORTEX_DATA_HOST:-0.0.0.0}"
export VORTEX_DATA_PORT="${VORTEX_DATA_PORT:-8765}"

export VORTEX_QMT_HOST="${VORTEX_QMT_HOST:-0.0.0.0}"
export VORTEX_QMT_PORT="${VORTEX_QMT_PORT:-8767}"

export VORTEX_BACKTEST_HOST="${VORTEX_BACKTEST_HOST:-0.0.0.0}"
export VORTEX_BACKTEST_PORT="${VORTEX_BACKTEST_PORT:-8766}"   # 规范端口：避开 data 的 8765

export VORTEX_TRADER_HOST="${VORTEX_TRADER_HOST:-0.0.0.0}"
export VORTEX_TRADER_PORT="${VORTEX_TRADER_PORT:-8768}"

SERVICES_DIR="${VORTEX_SERVICES_DIR:-/app/services}"
svc_dir() { echo "${SERVICES_DIR}/vortex_$1"; }

# 服务是否已装入镜像（预留的 trader 未检出时为否）
is_installed() {
  local s="$1" d; d="$(svc_dir "$s")"
  [ -f "${d}/pyproject.toml" ] || command -v "vortex-${s}" >/dev/null 2>&1
}

# 内置默认启动命令（无 deploy/run.sh 时回退）。用 exec 让信号直达服务进程。
builtin_start() {
  case "$1" in
    data)
      mkdir -p "${VORTEX_WORKSPACE}"
      vortex-data --root "${VORTEX_WORKSPACE}" init
      exec vortex-data --root "${VORTEX_WORKSPACE}" server start \
        --host "${VORTEX_DATA_HOST}" --port "${VORTEX_DATA_PORT}" ;;
    qmt)
      mkdir -p "${VORTEX_STATE}"
      exec vortex-qmt serve ;;
    backtest)
      mkdir -p "${VORTEX_STATE}"
      exec vortex-backtest serve ;;
    trader)
      if command -v vortex-trader >/dev/null 2>&1; then exec vortex-trader serve; fi
      echo "vortexctl: trader 预留、未装入，跳过" >&2; exit 0 ;;
    *)
      echo "vortexctl: 未知服务 '$1'（可选 data|qmt|backtest|trader）" >&2; exit 2 ;;
  esac
}

# 启动单个服务：优先各仓 deploy/run.sh，否则内置默认
start_one() {
  local s="$1" runner; runner="$(svc_dir "$s")/deploy/run.sh"
  if [ -x "${runner}" ]; then
    echo ">> vortexctl: 启动 ${s}（来自 $(svc_dir "$s")/deploy/run.sh）"
    exec "${runner}"
  fi
  echo ">> vortexctl: 启动 ${s}（内置默认命令）"
  builtin_start "$s"
}

# 解析（list 用）：报告每个服务用 run.sh 还是内置默认、是否已装入
resolve_info() {
  local s="$1" runner; runner="$(svc_dir "$s")/deploy/run.sh"
  if ! is_installed "$s"; then echo "${s}: 未装入（预留/未检出）"; return; fi
  if [ -x "${runner}" ]; then echo "${s}: deploy/run.sh"; else echo "${s}: 内置默认"; fi
}

usage() {
  sed -n '2,20p' "$0"
  echo
  echo "已装入服务："
  local s; for s in data qmt backtest trader; do echo "  $(resolve_info "$s")"; done
}

main() {
  local cmd="${1:-}"
  case "${cmd}" in
    ""|-h|--help|help) usage ;;
    list) local s; for s in data qmt backtest trader; do resolve_info "$s"; done ;;
    data|qmt|backtest|trader) start_one "${cmd}" ;;
    *) echo "vortexctl: 未知命令 '${cmd}'（list|data|qmt|backtest|trader）" >&2; exit 2 ;;
  esac
}

if [ "${VORTEX_DEBUG_PORTS:-}" = "1" ]; then
  echo "VORTEX_DATA_PORT=${VORTEX_DATA_PORT} VORTEX_QMT_PORT=${VORTEX_QMT_PORT} VORTEX_BACKTEST_PORT=${VORTEX_BACKTEST_PORT} VORTEX_TRADER_PORT=${VORTEX_TRADER_PORT}"
fi

main "$@"
